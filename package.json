{
  "name": "hehe-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "set NODE_OPTIONS=--max-old-space-size=8192 && nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "check": "vue-tsc --noEmit",
    "supabase:start": "supabase start",
    "apm:monitor": "node scripts/test-supabase-connection.mjs",
    "dev:all": "concurrently \"npm:supabase:start\" \"npm:dev\"",
    "gen:types": "supabase gen types typescript --linked > app/types/database.types.ts",
    "gen:types:local": "supabase gen types typescript --local > app/types/database.types.ts",
    "db:push": "supabase db push --linked && npm run gen:types",
    "test:api-safety": "node scripts/test-api-safety.mjs",
    "test:payment-strategies": "node scripts/test-payment-strategies.mjs",
    "test:supabase": "node scripts/test-supabase-connection.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run && playwright test",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "gen:crud": "node scripts/gen-crud-api.mjs",
    "gen:rls": "node scripts/generate-rls-sql.mjs",
    "scaffold": "node scripts/scaffolder.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "npx npm-check-updates",
    "deploy:promote": "node scripts/vercel-promote-production.mjs"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@sentry/nuxt": "^10.60.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "nuxt": "^4.4.8",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "resend": "^6.14.0",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.114",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/sitemap": "^8.2.1",
    "@playwright/test": "^1.61.1",
    "@types/qrcode": "^1.5.6",
    "@unocss/nuxt": "^66.7.2",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "unocss": "^66.7.2",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
