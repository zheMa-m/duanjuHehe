{
  "name": "hehe-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "check": "vue-tsc --noEmit",
    "supabase:start": "supabase start",
    "apm:monitor": "node scripts/test-supabase-connection.mjs",
    "dev:all": "concurrently \"npm:supabase:start\" \"npm:dev\"",
    "gen:types": "supabase gen types typescript --linked > app/types/database.types.ts",
    "gen:types:local": "supabase gen types typescript --local > app/types/database.types.ts",
    "db:push": "supabase db push --linked && npm run gen:types",
    "test:api-safety": "node scripts/test-api-safety.mjs",
    "test:supabase": "node scripts/test-supabase-connection.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "gen:crud": "node scripts/gen-crud-api.mjs",
    "gen:rls": "node scripts/generate-rls-sql.mjs",
    "scaffold": "node scripts/scaffolder.mjs"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.4.0",
    "@supabase/supabase-js": "^2.43.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "exifr": "^7.1.3",
    "nuxt": "^3.12.2",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.113",
    "@nuxt/image": "^2.0.0",
    "@unocss/nuxt": "^66.7.2",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.2",
    "unocss": "^66.7.2",
    "vue-tsc": "^2.0.22"
  }
}
