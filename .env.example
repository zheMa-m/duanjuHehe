# ──────────────────────────────────────────────────
# HeHe App 环境变量模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ──────────────────────────────────────────────────

# ── 数据库模式 ──
# true  = 内存 Mock DB（离线开发，无需 Supabase）
# false = 连接真实 Supabase PostgreSQL
MOCK_DB=true

# ── Supabase 真实数据库连接（MOCK_DB=false 时必填）──
# 前往 Supabase Dashboard → Settings → API 获取
# ❗ 生产环境建议使用 Supavisor Pooler URL（避免连接数耗尽）：
#    Settings → Database → Connection string → Transaction → 复制 Pooler URL
#    格式: postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ── Supabase 前端公开凭证（NUXT_PUBLIC_ 前缀，安全暴露给浏览器）──
# anon key 仅限 RLS 策略范围内的数据访问，严禁使用 service_role_key
NUXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# ── Stripe 密钥已迁移至 DB ──
# Stripe 私钥（Secret Key + Webhook Secret）已迁移至 DB system_configs.payment_secrets，
# 通过管理后台「业务运营 → 支付管理」配置，不再需要环境变量。

# ── 站点 URL（可选）──
# 本地默认 http://localhost:3000，Vercel 自动探测 VERCEL_URL
# 如需手动覆盖：NUXT_PUBLIC_BASE_URL=https://yourdomain.com

# ── 应用名称 ──
# 用于 2FA QR Code 等场景的 issuer 标识，默认为 HeHe Admin
APP_NAME=HeHe Admin

# ── Sentry 错误监控（可选）──
# 前往 https://sentry.io 创建项目获取 DSN
# 留空则禁用 Sentry，不影响应用正常运行
# 生产环境建议开启，配合 @sentry/nuxt 自动捕获客户端+服务端错误
SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>

# ── Resend 事务邮件（可选）──
# 前往 https://resend.com 创建 API Key
# 留空则回退到 Mock 模式（控制台输出）
RESEND_API_KEY=re_xxx
# 发件人地址（需在 Resend 验证域名）
EMAIL_FROM=HeHe <noreply@heheapp.com>


